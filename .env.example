# Example environment variables for Novo backend
# Supabase configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-public-key"

# Database connection (Supabase Postgres URL)
DATABASE_URL="postgresql://username:password@host:5432/database"

# JWT verification secret from Supabase project settings
SUPABASE_JWT_SECRET="your-jwt-secret"

# Never enable in production. When true, missing/invalid JWTs impersonate a guest customer.
ALLOW_INSECURE_DEV_AUTH="false"

# Frontend origin, used in email links
FRONTEND_URL="https://www.novong.com"

# Email sending (sender: info@novong.com). Set RESEND_API_KEY *or* the SMTP_* values.
# Until one is set, signup/reset codes fall back to Supabase's built-in mailer.
MAIL_FROM="info@novong.com"
MAIL_FROM_NAME="Novo"
MAIL_REPLY_TO="info@novong.com"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME="info@novong.com"
SMTP_PASSWORD=""
SMTP_SECURITY="starttls"

# Bachs payments (https://dashboard.bachs.io -> Developers). Use sk_sandbox_... to test.
# Webhook URL to register in Bachs: https://<your-backend>/api/v1/payments/webhook/bachs
BACHS_SECRET_KEY=""
BACHS_WEBHOOK_SECRET=""

# Web push notifications. Generate a key pair once (see app/core/push.py) and keep the private key secret.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@novong.com"
